{
  "name": "filerescue-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build && node scripts/build-offline.mjs && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "migrate": "tsx server/cli.ts migrate",
    "admin:create": "tsx server/cli.ts admin",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "predev:web": "node scripts/prepare-pdf-assets.mjs",
    "prebuild": "node scripts/prepare-pdf-assets.mjs",
    "pretest:e2e": "npm run build",
    "test:unit": "vitest run tests/engine.test.ts tests/recovery.test.tsx",
    "test:integration": "vitest run tests/server.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11",
    "@fastify/helmet": "^13",
    "@fastify/rate-limit": "^10",
    "@fastify/static": "^10.1.11",
    "@fontsource-variable/inter": "^5",
    "@radix-ui/react-accordion": "^1",
    "@radix-ui/react-slot": "^1",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "drizzle-orm": "^0.45",
    "fastify": "^5",
    "lucide-react": "^0.577",
    "motion": "^12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7",
    "tailwind-merge": "^3",
    "zod": "^4",
    "zustand": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.56",
    "@tailwindcss/vite": "^4",
    "@testing-library/react": "^16",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "concurrently": "^9",
    "eslint": "^9",
    "globals": "^16",
    "jsdom": "^27",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^7",
    "vitest": "^4"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
