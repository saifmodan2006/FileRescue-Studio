HOST=127.0.0.1
PORT=4310
DATABASE_PATH=./data/studio.sqlite
# Set to true when serving via HTTPS.
SECURE_COOKIES=false
# Set to the exact browser origin when overriding the local defaults.
# PUBLIC_ORIGIN=http://127.0.0.1:4310

# Hosted API settings. Set these only on Render or when testing hosted mode.
# STUDIO_HOSTED=true
# PUBLIC_ORIGIN=https://your-pages-origin.example
# DATABASE_URL=
# STUDIO_PROXY_SECRET=
#
# Cloudflare Pages production bindings. Enter in the Pages dashboard.
# STUDIO_API_ORIGIN=https://your-render-origin.example
# STUDIO_PROXY_SECRET=
